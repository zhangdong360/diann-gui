#!/usr/bin/env bash
# diann-gui —— 以当前用户身份启动 DIA-NN GUI (自托管模式)
#
# 用法:
#   bin/diann-gui                 # 前台启动, 随机端口 30000-39999
#   bin/diann-gui --port 3838     # 指定端口
#   bin/diann-gui --init          # 生成 ~/.diann_gui/config.R 设置文件 (已存在则跳过)
#
# 浏览器访问:
#   本机:     http://localhost:<port>
#   远程集群: ssh -L <port>:localhost:<port> <用户>@<集群>  (先建隧道再打开上述地址)
#   RStudio Server 内置终端运行时, RStudio 会自动代理端口并弹出浏览器窗口, 无需隧道
set -u

HERE="$(cd "$(dirname "$0")/.." && pwd)"
CONFIG_DIR="${HOME}/.diann_gui"
CONFIG_FILE="${CONFIG_DIR}/config.R"

# 显式用系统 R: 避免误入版本过低的 conda R (共享包库按系统 R 版本构建)
RBIN="/usr/bin/R"
[ -x "$RBIN" ] || RBIN="$(command -v R || true)"

die() { echo "错误: $*" >&2; exit 1; }

# ---------- --init: 生成每用户设置文件 (一键部署的写入入口) ----------
if [ "${1:-}" = "--init" ]; then
  mkdir -p "$CONFIG_DIR"
  if [ -f "$CONFIG_FILE" ]; then
    echo "已存在 ${CONFIG_FILE}, 未改动。"
  else
    sed -e "s|DIANN_GUI_USER_HOME|${HOME}|g" "${HERE}/config.example.R" > "$CONFIG_FILE"
    echo "已生成 ${CONFIG_FILE}"
  fi
  echo "按需编辑后, 运行 bin/diann-gui 启动。"
  exit 0
fi

# ---------- 参数 ----------
PORT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --port) PORT="${2:-}"; shift 2 ;;
    --port=*) PORT="${1#--port=}"; shift ;;
    *) die "未知参数: $1 (支持 --port N / --init)" ;;
  esac
done
[ -n "$PORT" ] || PORT=$((30000 + RANDOM % 10000))

# ---------- 依赖检查 ----------
if [ -z "$RBIN" ]; then
  die "未找到 R。请先安装 R (>= 4.1), 或修改本脚本顶部的 RBIN。"
fi
MISSING="$("$RBIN" --no-save --slave -e '
cfg_env <- Sys.getenv("DIANN_GUI_CONFIG")
cfg <- if (nzchar(cfg_env) && file.exists(cfg_env)) cfg_env else {
  c1 <- file.path(path.expand("~"), ".diann_gui", "config.R")
  c2 <- file.path("'"$HERE"'", "config.R")
  if (file.exists(c1)) c1 else if (file.exists(c2)) c2 else ""
}
if (nzchar(cfg)) source(cfg)
if (exists("EXTRA_LIB") && length(EXTRA_LIB) == 1 && nzchar(EXTRA_LIB) && dir.exists(EXTRA_LIB)) {
  .libPaths(c(EXTRA_LIB, .libPaths()))
}
miss <- character(0)
for (p in c("shiny", "shinydashboard", "shinyFiles")) {
  if (!requireNamespace(p, quietly = TRUE)) miss <- c(miss, p)
}
cat(paste(miss, collapse = " "))' 2>/dev/null)"
if [ -n "$(echo "$MISSING" | tr -d '[:space:]')" ]; then
  cat >&2 <<EOF
缺少 R 包: $(echo "$MISSING" | xargs)
两种解决方式 (任选其一):
  1. 运行 bin/diann-gui --init 生成 ~/.diann_gui/config.R,
     在其中设置 EXTRA_LIB 指向集群上全员可读的共享包库;
  2. 自行安装: R -e 'install.packages(c("$(echo "$MISSING" | xargs | sed "s/ /\", \"/g"))")'
EOF
  exit 1
fi

# ---------- 启动 ----------
HOST="127.0.0.1"
echo "DIA-NN GUI (自托管, 用户: $(id -un))"
echo "  本机访问:   http://localhost:${PORT}"
echo "  远程集群时: ssh -L ${PORT}:localhost:${PORT} <用户>@<集群> 后再打开上述地址"
echo "  停止: Ctrl+C"
echo
exec "$RBIN" --no-save --slave -e "shiny::runApp('${HERE}', port = ${PORT}, host = '${HOST}', launch.browser = FALSE)"
